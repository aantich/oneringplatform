# Copy this file to apps/api/.env for local development. Never commit real values.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
SERPER_KEY=
ZENROWS_API_KEY=

# Default interactive agent configuration. Provider-specific live smoke tests
# use the model variables below so both connectors can be exercised safely.
ONERING_DEFAULT_CONNECTOR=openai-main
ONERING_DEFAULT_MODEL=gpt-5.6-terra
ONERING_OPENAI_MODEL=gpt-5.6-terra
ONERING_ANTHROPIC_MODEL=claude-sonnet-5

PORT=4100
WEB_ORIGIN=http://localhost:5173
# Local npm scripts normally discover credentials from the running icos
# mongodb-atlas container. Uncomment only to override that behavior.
# MONGO_URI=mongodb://USER:PASSWORD@127.0.0.1:27017/oneringplatform?authSource=admin&directConnection=true
# MONGO_TEST_URI=mongodb://USER:PASSWORD@127.0.0.1:27017/oneringplatform_test?authSource=admin&directConnection=true
# Development scripts set LOCAL_DEV_AUTH=1 automatically. Never enable it in production.
# LOCAL_DEV_AUTH=1
RUNTIME_SESSION_SECRET=replace-with-at-least-32-random-characters
CONTROL_PLANE_JWT_SECRET=replace-with-at-least-32-random-characters
IDENTITY_EXCHANGE_SECRET=replace-with-at-least-32-random-characters
# Encrypts persisted OneRingAI connector credentials and OAuth tokens.
CONNECTOR_ENCRYPTION_KEY=replace-with-an-independent-32-character-secret
# Exact public origins used when registering Google/Microsoft OAuth applications.
PUBLIC_API_ORIGIN=http://127.0.0.1:4100
WEB_APP_ORIGIN=http://127.0.0.1:5173
PLATFORM_HOSTS=localhost,127.0.0.1
