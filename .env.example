# Never commit real values. For local development, export these variables or
# point your shell at an external secret file before running npm run dev.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
SERPER_KEY=
ZENROWS_API_KEY=
ONERING_DEFAULT_CONNECTOR=openai-main
ONERING_DEFAULT_MODEL=gpt-5.4-mini
PORT=4100
WEB_ORIGIN=http://localhost:5173
# Local npm scripts normally discover credentials from the running icos
# mongodb-atlas container. Uncomment only to override that behavior.
# MONGO_URI=mongodb://USER:PASSWORD@127.0.0.1:27017/oneringplatform?authSource=admin&directConnection=true
# MONGO_TEST_URI=mongodb://USER:PASSWORD@127.0.0.1:27017/oneringplatform_test?authSource=admin&directConnection=true
RUNTIME_SESSION_SECRET=replace-with-at-least-32-random-characters
CONTROL_PLANE_JWT_SECRET=replace-with-at-least-32-random-characters
IDENTITY_EXCHANGE_SECRET=replace-with-at-least-32-random-characters
PLATFORM_HOSTS=localhost,127.0.0.1
